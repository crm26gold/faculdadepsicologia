 {
  "name": "ver_tela",
  "title": "Ver uma tela da Jornada (print)",
  "annotations": {
   "readOnlyHint": true,
   "openWorldHint": false
  },
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "tela": {
     "description": "Sem tela, use ultima_acao para mostrar a tela do que mudou.",
     "type": "string",
     "enum": [
      "meu_dia",
      "financas",
      "agenda",
      "habitos",
      "metas",
      "anotacoes"
     ]
    },
    "ultima_acao": {
     "default": false,
     "description": "Mostra no print o que esta conexão acabou de fazer, nas últimas 24 horas.",
     "type": "boolean"
    }
   }
  },
  "outputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "tela": {
     "type": "string",
     "enum": [
      "meu_dia",
      "financas",
      "agenda",
      "habitos",
      "metas",
      "anotacoes"
     ]
    },
    "resumo": {
     "type": "string"
    },
    "link": {
     "type": [
      "string",
      "null"
     ]
    },
    "mudancas": {
     "description": "Com ultima_acao: o que esta conexão acabou de fazer, nas palavras do recibo.",
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "alterado_em": {
     "description": "Com ultima_acao: quando foi a alteração.",
     "type": "string"
    }
   },
   "required": [
    "tela",
    "resumo",
    "link"
   ],
   "additionalProperties": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://jornada/print-v1.html"
   },
   "ui/resourceUri": "ui://jornada/print-v1.html"
  }
 },
