[
 {
  "name": "consultar_jornada",
  "title": "Consultar a Jornada",
  "annotations": {
   "readOnlyHint": true,
   "openWorldHint": false
  },
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "section": {
     "default": "resumo",
     "type": "string",
     "enum": [
      "resumo",
      "agenda",
      "busca",
      "pendentes",
      "focos",
      "configuracoes",
      "compromisso",
      "anotacao",
      "financeiro",
      "habito",
      "meta",
      "projeto",
      "curso",
      "materia",
      "aula",
      "caderno",
      "flashcard",
      "area"
     ]
    },
    "search": {
     "default": "",
     "type": "string",
     "maxLength": 160
    },
    "from": {
     "type": "string"
    },
    "to": {
     "type": "string"
    },
    "includeContent": {
     "default": false,
     "type": "boolean"
    },
    "cursor": {
     "description": "Só na busca: o \"cursor\" da página anterior, para continuar a mesma busca.",
     "type": "string",
     "maxLength": 40
    },
    "limit": {
     "description": "Só na busca: itens por página, de 1 a 40 (padrão 40).",
     "type": "integer",
     "minimum": 1,
     "maximum": 40
    }
   }
  },
  "outputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "today": {
     "type": "string",
     "description": "Hoje, AAAA-MM-DD, no fuso America/Sao_Paulo."
    },
    "found": {
     "description": "Quantos itens existem; 0 = não existe.",
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    },
    "message": {
     "description": "Onde procurei, quando não encontrei.",
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "versao": {
        "description": "Muda quando o registro muda.",
        "type": "string"
       }
      },
      "additionalProperties": {}
     }
    },
    "cursor": {
     "description": "Na busca: repita a mesma busca com este cursor para ver a próxima página.",
     "type": "string"
    }
   },
   "required": [
    "today"
   ],
   "additionalProperties": {}
  },
  "_meta": null
 },
 {
  "name": "registrar_na_jornada",
  "title": "Registrar na Jornada",
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": false
  },
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "acoes": {
     "minItems": 1,
     "maxItems": 8,
     "type": "array",
     "items": {
      "oneOf": [
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "compromisso"
         },
         "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "date": {
          "type": "string"
         },
         "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
         },
         "daqui": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
         },
         "kind": {
          "type": "string",
          "enum": [
           "Compromisso",
           "Tarefa",
           "Reunião",
           "Consulta",
           "Treino",
           "Lazer",
           "Prática",
           "Pagamento",
           "Estudo",
           "Prova",
           "Trabalho",
           "Aula"
          ]
         },
         "minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
         },
         "area": {
          "type": "string",
          "maxLength": 100
         },
         "subject": {
          "type": "string",
          "maxLength": 100
         },
         "remind": {
          "type": "object",
          "properties": {
           "minutes": {
            "type": "number",
            "enum": [
             0,
             5,
             10,
             15,
             30,
             60,
             120,
             1440
            ]
           },
           "level": {
            "type": "string",
            "enum": [
             "suave",
             "normal",
             "insistente"
            ]
           }
          },
          "required": [
           "minutes",
           "level"
          ],
          "additionalProperties": false
         }
        },
        "required": [
         "type",
         "title"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "anotacao"
         },
         "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
         },
         "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "notebook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
         },
         "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "link": {
          "type": "string",
          "maxLength": 2000
         }
        },
        "required": [
         "type",
         "text"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "financeiro"
         },
         "flow": {
          "type": "string",
          "enum": [
           "income",
           "expense"
          ]
         },
         "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
         },
         "category": {
          "type": "string",
          "maxLength": 100
         },
         "date": {
          "type": "string"
         },
         "pending": {
          "type": "boolean"
         },
         "nature": {
          "type": "string",
          "enum": [
           "fixed",
           "variable",
           "oneoff"
          ]
         },
         "installments": {
          "type": "integer",
          "minimum": 2,
          "maximum": 120
         },
         "monthly": {
          "type": "integer",
          "minimum": 2,
          "maximum": 120
         }
        },
        "required": [
         "type",
         "flow",
         "description",
         "amount",
         "date"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "foco"
         },
         "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
         }
        },
        "required": [
         "type",
         "activity"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "concluir"
         },
         "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         }
        },
        "required": [
         "type",
         "title"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "criar"
         },
         "entity": {
          "type": "string",
          "enum": [
           "compromisso",
           "anotacao",
           "financeiro",
           "habito",
           "meta",
           "projeto",
           "curso",
           "materia",
           "aula",
           "caderno",
           "flashcard",
           "area"
          ]
         },
         "fields": {
          "type": "object",
          "propertyNames": {
           "type": "string",
           "maxLength": 40
          },
          "additionalProperties": {}
         }
        },
        "required": [
         "type",
         "entity",
         "fields"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "editar"
         },
         "entity": {
          "type": "string",
          "enum": [
           "compromisso",
           "anotacao",
           "financeiro",
           "habito",
           "meta",
           "projeto",
           "curso",
           "materia",
           "aula",
           "caderno",
           "flashcard",
           "area"
          ]
         },
         "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "fields": {
          "type": "object",
          "propertyNames": {
           "type": "string",
           "maxLength": 40
          },
          "additionalProperties": {}
         }
        },
        "required": [
         "type",
         "entity",
         "target",
         "fields"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "excluir"
         },
         "entity": {
          "type": "string",
          "enum": [
           "compromisso",
           "anotacao",
           "financeiro",
           "habito",
           "meta",
           "projeto",
           "curso",
           "materia",
           "aula",
           "caderno",
           "flashcard",
           "area"
          ]
         },
         "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         }
        },
        "required": [
         "type",
         "entity",
         "target"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "habito_feito"
         },
         "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         },
         "date": {
          "type": "string"
         },
         "done": {
          "default": true,
          "type": "boolean"
         }
        },
        "required": [
         "type",
         "target",
         "date"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "controlar_foco"
         },
         "operation": {
          "type": "string",
          "enum": [
           "pausar",
           "retomar",
           "encerrar"
          ]
         },
         "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
         }
        },
        "required": [
         "type",
         "operation"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "ajustar_foco"
         },
         "target": {
          "type": "string",
          "maxLength": 160
         },
         "date": {
          "type": "string"
         },
         "minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
         },
         "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
         }
        },
        "required": [
         "type"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "saldo_inicial"
         },
         "amount": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
         },
         "date": {
          "type": "string"
         }
        },
        "required": [
         "type",
         "amount"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "semestre"
         },
         "start": {
          "type": "string"
         },
         "end": {
          "type": "string"
         }
        },
        "required": [
         "type"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "perfil"
         },
         "fields": {
          "type": "object",
          "properties": {
           "name": {
            "type": "string",
            "maxLength": 100
           },
           "course": {
            "type": "string",
            "maxLength": 100
           },
           "semester": {
            "type": "string",
            "maxLength": 60
           },
           "institution": {
            "type": "string",
            "maxLength": 160
           },
           "campus": {
            "type": "string",
            "maxLength": 100
           },
           "registration": {
            "type": "string",
            "maxLength": 100
           },
           "email": {
            "anyOf": [
             {
              "type": "string",
              "const": ""
             },
             {
              "type": "string",
              "maxLength": 254,
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
             }
            ]
           },
           "phone": {
            "type": "string",
            "maxLength": 40
           }
          }
         }
        },
        "required": [
         "type",
         "fields"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "coletivo"
         },
         "area": {
          "type": "string",
          "enum": [
           "salas",
           "trabalhos",
           "contatos",
           "administracao",
           "conta"
          ]
         },
         "acao": {
          "type": "object",
          "propertyNames": {
           "type": "string"
          },
          "additionalProperties": {}
         }
        },
        "required": [
         "type",
         "area",
         "acao"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "mostrar_tela"
         },
         "tela": {
          "type": "string",
          "enum": [
           "meu_dia",
           "financas",
           "agenda",
           "habitos",
           "metas",
           "anotacoes"
          ]
         }
        },
        "required": [
         "type",
         "tela"
        ]
       },
       {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "const": "restaurar"
         },
         "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
         }
        },
        "required": [
         "type",
         "target"
        ]
       }
      ]
     },
     "description": "Ações validadas, na ordem em que devem ser aplicadas."
    },
    "request_id": {
     "description": "UUID do pedido; reutilize ao repetir o mesmo pedido após uma falha de conexão, por até 90 dias.",
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "pedido": {
     "description": "As palavras da pessoa, como ela disse (por exemplo \"me lembra daqui 3 minutos de beber água\"). A Jornada usa para garantir o aviso e a hora certa.",
     "type": "string",
     "maxLength": 2000
    }
   },
   "required": [
    "acoes"
   ]
  },
  "outputSchema": null,
  "_meta": null
 },
