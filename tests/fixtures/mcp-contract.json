   "idempotentHint": false,
   "openWorldHint": false
  },
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "acao": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "action": {
         "type": "string",
         "const": "create_space"
        },
        "kind": {
