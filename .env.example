# Modelo público sem dados pessoais ou credenciais. Nunca versionar .env.local.
# Contrato de ambientes e verificações: docs/DEPLOYMENT.md.

# Demonstração com dados sintéticos; workspace privado usa APP_MODE=private.
# Localmente a demo funciona sem Vercel, Supabase ou conta do proprietário.
APP_MODE=demo

# Origem canônica exata, sem caminho, parâmetros ou fragmento.
# Em hospedagem, usar a origem HTTPS do ambiente correspondente.
APP_ORIGIN=http://127.0.0.1:3000

# Somente para demo hospedada: ID do projeto exclusivo de demonstração.
# Deve coincidir com VERCEL_PROJECT_ID e ser diferente do projeto privado.
# VERCEL_PROJECT_ID é fornecido pela plataforma; não forjar esse valor.
# Deixar vazio na demo local e no workspace privado.
DEMO_VERCEL_PROJECT_ID=

# Somente no ambiente privado verificado. Deixar vazios/ausentes na demo.
# NEXT_PUBLIC_* pode integrar o código do navegador; nunca colocar segredos aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Proprietário privado explicitamente autorizado: UUID de Auth e e-mail exato.
# Não publicar valores reais nem promover automaticamente o primeiro login.
APP_OWNER_USER_ID=
APP_OWNER_EMAIL=

# Ativar cada integração somente após a verificação externa correspondente.
# Google OAuth e Supabase remotos ainda não foram configurados/verificados.
GOOGLE_AUTH_ENABLED=false
FACULDADE_CLOUD_WORKSPACE=false

# Prévia local legada; não deve ser necessária para APP_MODE=demo.
# Não libera hospedagem nem substitui o isolamento entre demo e privado.
FACULDADE_LOCAL_PREVIEW=false

# Não adicionar credenciais de IA, Google, chaves administrativas ou tokens à demo.
# Preservar dados existentes na chave local. Novo privado vazio; demo sintética.
