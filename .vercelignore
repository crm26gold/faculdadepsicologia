# Only application source is needed for deployment. No local context or data.
# Do not list /.git: in Git deployments Vercel applies this file right after the clone,
# before the Ignored Build Step, which needs Git history. The Vercel CLI never uploads .git.
/.agents
/.codex
/.claude
/.codex-remote-attachments
/.next
/.vercel
/.local
/node_modules
/integrations
/public/spelling
.env*
*.md
/tests
/test-results
/playwright-report
playwright.config.ts
/supabase
skills-lock.json
*.tsbuildinfo
*.log
